# Copy this file to .env.local for local dev, and set the SAME variables in the
# Vercel project's Environment Variables for production. Never commit real keys.

# Google AI Studio (Gemini) API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional: override the default model (gemma-4-31b-it)
GEMINI_MODEL=gemma-4-31b-it
